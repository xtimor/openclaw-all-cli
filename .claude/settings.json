{
  "permissions": {
    "allow": [
      "Bash(uv run _bmad/scripts/*)",
      "Bash(uv run */_bmad/scripts/*)",
      "Bash(scripts/agent-relay.sh *)",
      "Bash(bash scripts/agent-relay.sh *)",
      "Bash(./scripts/agent-relay.sh *)",
      "Bash(scripts/batch-pending.sh set *)",
      "Bash(scripts/batch-pending.sh clear)",
      "Bash(scripts/upstream-issue.sh *)",
      "Bash(bash scripts/upstream-issue.sh *)",
      "Bash(./scripts/upstream-issue.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/batch-pending.sh stop-hook"
          }
        ]
      }
    ]
  }
}