{
  "permissions": {
    "allow": [
      "Bash(uv run _bmad/scripts/*)",
      "Bash(uv run */_bmad/scripts/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
